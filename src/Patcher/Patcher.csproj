<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.7.2 ships with Windows 10 and 11, so players can run
       the installer without installing a .NET runtime first. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>5</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GarRevival.Patcher</AssemblyName>
    <RootNamespace>GarRevival.Patcher</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
